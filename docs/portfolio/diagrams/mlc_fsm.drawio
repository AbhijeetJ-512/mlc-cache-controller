<mxCell id="t4_lbl" value="hit: same-cycle response" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="79.2" y="56.5" width="161.6" height="19" as="geometry"/></mxCell>
