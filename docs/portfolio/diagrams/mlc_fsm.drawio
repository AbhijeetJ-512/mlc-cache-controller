<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="mlc_cache_controller---controller-state-machines" name="mlc_cache_controller - controller state machines">
<mxGraphModel dx="1320" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="820" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="g2" value="L2 and L3 (write-back, set associative): the same controller, 5 states" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="680" height="680" as="geometry"/></mxCell>
<mxCell id="g1" value="L1 (write-through, direct mapped): 3 states, TAG_CHECK is combinational" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="560" height="680" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;req_ready = 1 (no pending forward)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;ALLOC_FILL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;req_ready = 0; the fill request is&lt;br&gt;held until the response arrives&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="u1" value="&lt;b&gt;UPDATE_TAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;commit tag, valid, data;&lt;br&gt;response waits for resp_ready&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;req_ready = 1&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="t2b" value="&lt;b&gt;TAG_CHECK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;victim: free way, else PLRU&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="e2" value="&lt;b&gt;EVICT_WRITEBACK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;dirty victim goes downstream&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;ALLOC_FILL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;request the line downstream&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="u2" value="&lt;b&gt;UPDATE_TAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;tag, data, dirty (= store), PLRU&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="420" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="f1" value="No EVICT state exists: write-through lines are never dirty, so a line is simply overwritten.&lt;br&gt;A store hit updates the L1 array and is forwarded to L2 (a one-entry skid holds the&lt;br&gt;forward if L2 is not ready); a store miss is allocated, merged and then forwarded." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="574.72" height="47.25" as="geometry"/></mxCell>
<mxCell id="f2t" value="Writes are posted: a store hit or a write-allocated miss returns to IDLE without a response.&lt;br&gt;L2 and L3 differ only in parameters (ways, line size, write width) and in what sits downstream:&lt;br&gt;the adapter for L2, the AXI4 fill engine for L3. A free (invalid) way is always used before&lt;br&gt;the PLRU choice evicts a live line. Misses are blocking: one outstanding miss per level." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="593.2" height="61" as="geometry"/></mxCell>
<mxCell id="t1" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="a1" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1_lbl" value="request misses" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="101.2" y="230.5" width="97.6" height="19" as="geometry"/></mxCell>
<mxCell id="t2" style="endArrow=classic;startArrow=none;html=1;strokeColor=#222222;strokeWidth=1.8;rounded=0;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="u1" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t2_lbl" value="L2 response valid" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#222222;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="91.6" y="430.5" width="116.8" height="19" as="geometry"/></mxCell>
