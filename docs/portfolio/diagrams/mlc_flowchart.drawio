<diagram id="mlc_cache_controller---request-and-miss-flow" name="mlc_cache_controller - request and miss flow">
<mxGraphModel dx="1420" dy="1540" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1540" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="s" value="&lt;b&gt;CPU request at an L1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;load, store or instruction fetch&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="30" width="360" height="55" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;L1 hit ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;direct mapped: one tag compare&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="115" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Respond from L1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;load: the word; store: update L1 and forward&lt;br&gt;the store to L2 (write-through, posted)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;L1 ALLOC_FILL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;request the 32 B line from L2; the arbiter lets one&lt;br&gt;requester through and holds the other&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="225" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;L2 hit ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;4 tag compares in parallel&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="325" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;L2 returns its 32 B line&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;a store merges its bytes and sets the dirty bit;&lt;br&gt;PLRU is updated&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;L2 TAG_CHECK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;victim: a free way first, else the PLRU choice&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="435" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;victim dirty ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="535" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="w2" value="&lt;b&gt;L2 EVICT_WRITEBACK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the 32 B line goes to L3 through the adapter&lt;br&gt;as one posted half-line write&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="540" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="m3" value="&lt;b&gt;L2 ALLOC_FILL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;request the line from L3 through the adapter&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="645" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;L3 hit ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;8 tag compares in parallel&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="745" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="h3" value="&lt;b&gt;L3 returns its 64 B line&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the adapter keeps the 32 B half&lt;br&gt;selected by address bit 5&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="750" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="m4" value="&lt;b&gt;L3 TAG_CHECK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;victim: a free way first, else the PLRU choice&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="855" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;victim dirty ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="955" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="w3" value="&lt;b&gt;AXI4 write burst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;16 beats x 32 bit, wait for the B response&lt;br&gt;(the memory sees the write before the read)&lt;/font&gt;" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="960" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="m5" value="&lt;b&gt;AXI4 read burst&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;16 beats x 32 bit INCR into the L3 line&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1065" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="m6" value="&lt;b&gt;L3 UPDATE_TAG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;tag, valid, data; clean&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1165" width="360" height="60" as="geometry"/></mxCell>
<mxCell id="m7" value="&lt;b&gt;Fill returns up the hierarchy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;L2 UPDATE_TAG, then L1 UPDATE_TAG:&lt;br&gt;tag, valid, data written at each level&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1255" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="e" value="&lt;b&gt;Response to the CPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;the request is then re-presented as a hit&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1365" width="360" height="55" as="geometry"/></mxCell>
<mxCell id="n" value="Not drawn: a store that misses L1 is allocated (fill, merge), then forwarded to L2 as a write-through; writes to L2 and L3 are posted&lt;br&gt;(no response); the L1 controller has a one-entry skid that holds a write forward if L2 is not ready. A hit completes in the cycle it is&lt;br&gt;accepted at every level, so the CPU must not derive resp_ready from resp_valid." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="1445" width="839.6" height="47.25" as="geometry"/></mxCell>
