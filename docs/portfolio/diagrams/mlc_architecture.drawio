<mxCell id="arb" value="&lt;b&gt;l1_l2_arbiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;round robin, one outstanding read&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="340" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="l2" value="&lt;b&gt;L2 cache&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;l2_cache_ctrl + plru_tree&lt;br&gt;unified, write-back&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="ad" value="&lt;b&gt;l2_l3_width_adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;32 B &amp;lt;-&amp;gt; 64 B line adaptation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="660" width="300" height="90" as="geometry"/></mxCell>
