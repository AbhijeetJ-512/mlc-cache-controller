<mxCell id="n1" value="&lt;b&gt;L1 (two instances)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;4 KiB, 32 B lines, direct mapped&lt;br&gt;write-through, no dirty bit&lt;br&gt;tag 20 | index 7 | offset 5&lt;br&gt;reset_sync (in the top): asynchronous&lt;br&gt;assert, synchronous de-assert&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#999933;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Arbiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;three state bits (busy, owner, last)&lt;br&gt;routes each response to its owner&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#999933;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="325" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;L2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;32 KiB, 32 B lines, 4-way&lt;br&gt;write-back, tree PLRU&lt;br&gt;tag 19 | index 8 | offset 5&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#999933;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="250" height="140" as="geometry"/></mxCell>
