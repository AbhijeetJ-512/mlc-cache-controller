# Simulation binaries (compiled test executables)
sim/tb_*
!sim/tb_*.*
sim/*.vcd

# Parameter-guard check binaries from `make elab` (sources are named so this cannot match them)
sim/elab_*

# VCD waveform dumps (not logs)
*.vcd

# Icarus default output of a bare `iverilog` run without -o, and any vvp image
a.out
*.vvp

# Local tool state: worktrees, per-user settings and scratch workspaces. Only these paths are ignored,
# so a project-level config folder added later stays trackable.
.claude/worktrees/
.claude/settings.local.json
.superpowers/

# Synthesis scratch (Phase 7): Yosys logs and package copies. build/reports/ is tracked evidence.
build/work/
build/netlists/
__pycache__/
build/lib/

# Simulator builds of the checker runs, the mutation campaigns and the system test; build/reports/ stays tracked
build/*
!build/reports/
