# Simulation binaries (compiled test executables)
sim/tb_*
!sim/tb_*.sv
!sim/tb_*.v
sim/*.vcd

# Parameter-guard check binaries from `make elab` (sources are named so this cannot match them)
sim/elab_*

# VCD waveform dumps (not logs)
*.vcd

# Icarus default output of a bare `iverilog` run without -o, and any vvp image
a.out
*.vvp

# Local tooling state: Claude Code worktrees, per-user settings, and subagent scratch workspaces.
# Only these paths are ignored, so any project-level .claude/ config added later stays trackable.
.claude/worktrees/
.claude/settings.local.json
.superpowers/
