# Elaboration-only check: hierarchy + latch/tristate detection.
# Does NOT perform technology mapping - see scripts/synth.ys (Phase 7) for that.
#
# Each top gets its own `design -reset` first. `hierarchy -top <mod>` prunes
# every module unreachable from that top, so checking l1_icache_ctrl and
# l1_dcache_ctrl in one continuous design state would have the first
# `hierarchy -top` call delete the second module before its own check ever
# runs - `design -reset` avoids that by starting each check from a clean,
# freshly-read design.
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/common/reset_sync.sv
read_verilog -sv rtl/l1/l1_cache_ctrl.sv
read_verilog -sv rtl/l1/l1_icache_ctrl.sv
hierarchy -top l1_icache_ctrl
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf

design -reset
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/common/reset_sync.sv
read_verilog -sv rtl/l1/l1_cache_ctrl.sv
read_verilog -sv rtl/l1/l1_dcache_ctrl.sv
hierarchy -top l1_dcache_ctrl
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf

design -reset
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/replace/plru_tree.sv
read_verilog -sv rtl/l2/l2_cache_ctrl.sv
hierarchy -top l2_cache_ctrl
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf
# D-019, checked on the real module instead of read off warning text: exactly 3 real $mem cells
# survive (tag_array, dirty_array, data_array - valid_array is expected to flatten), and data_array
# is one of them.
select -assert-count 3 l2_cache_ctrl/m:*
select -assert-count 1 l2_cache_ctrl/m:data_array

design -reset
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/mem_if/axi4_fill_engine.sv
hierarchy -top axi4_fill_engine
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf

design -reset
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/adapter/l2_l3_width_adapter.sv
hierarchy -top l2_l3_width_adapter
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf

# L3 is the same controller at L3's parameters (FR-17). Re-checked at its size: 2 Mbit of data
# array must still come out as a real memory, not as discrete registers.
design -reset
read_verilog -sv rtl/common/mlc_pkg.sv
read_verilog -sv rtl/replace/plru_tree.sv
read_verilog -sv rtl/l2/l2_cache_ctrl.sv
read_verilog -sv rtl/l3/l3_cache_ctrl.sv
hierarchy -top l3_cache_ctrl
proc
opt_clean
check -assert
select -assert-none t:$dlatch t:$adlatch t:$dlatchsr
tribuf
select -assert-none t:$tribuf
select -assert-count 3 m:*
select -assert-count 1 m:data_array
